{
  "manifest_version": 3,
  "name": "Unlimeety",
  "version": "1.3.1",
  "version_name": "1.3.1",
  "description": "Local meeting transcription for Google Meet.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "*://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css",
        "content-light.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Inter-400.woff2",
        "fonts/Inter-500.woff2",
        "fonts/Inter-600.woff2",
        "fonts/Inter-700.woff2",
        "fonts/JetBrainsMono-400.woff2",
        "fonts/JetBrainsMono-500.woff2"
      ],
      "matches": [
        "*://meet.google.com/*"
      ]
    }
  ]
}